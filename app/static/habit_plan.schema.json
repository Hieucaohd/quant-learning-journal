{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kế hoạch theo dõi theo ngày",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_type", "name", "tasks"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "plan_type": {"const": "habit"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "description": {"type": "string", "maxLength": 2000},
    "tasks": {
      "type": "array", "minItems": 1, "maxItems": 365,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "weekdays", "start_date"],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "description": {"type": "string", "maxLength": 2000},
          "weekdays": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 6}},
          "start_date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "end_date": {"type": ["string", "null"], "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "excluded_dates": {"type": "array", "maxItems": 366, "uniqueItems": true, "default": [], "items": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}}
        }
      }
    }
  }
}
